<?xml version="1.0"?>
<ruleset name="SkyPay WooCommerce">
  <description>WordPress coding standards for the SkyPay WooCommerce gateway.</description>
  <file>skypay-woocommerce.php</file>
  <file>includes</file>
  <file>uninstall.php</file>
  <arg name="extensions" value="php"/>
  <arg name="basepath" value="."/>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="manage_woocommerce"/>
      </property>
    </properties>
  </rule>
  <rule ref="WordPress.Files.FileName.InvalidClassFileName">
    <exclude-pattern>includes/class-skypay-*.php</exclude-pattern>
  </rule>
  <rule ref="Squiz.Commenting.ClassComment.Missing">
    <exclude-pattern>includes/class-skypay-*.php</exclude-pattern>
  </rule>
  <rule ref="Squiz.Commenting.FunctionComment.Missing">
    <exclude-pattern>includes/class-skypay-*.php</exclude-pattern>
  </rule>
  <exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
